<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luci_full_camera_pointcloud</name>
  <version>0.1.0</version>
  <description>Converts per-camera 16UC1 depth images from a LUCI-equipped wheelchair into a combined PointCloud2, using live per-chair calibration from luci_grpc_interface_node.</description>
  <maintainer email="rupak@luci.com">Rupak Dasgupta</maintainer>
  <license>Apache License 2.0</license>

  <url type="repository">https://github.com/lucimobility/luci-ros2-third-party</url>
  <url type="bugtracker">https://github.com/lucimobility/luci-ros2-third-party/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>luci_messages</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
